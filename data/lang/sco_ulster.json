    "y": 3,
    "name": "Sammy",
    "sprite": "farmer"
   },
   "intro": [
    "Out here on the Route, the land has its own words.",
    "Mind the sheuch on yer way hame, it's deeper than it looks."
   ],
   "words": [
    {
     "id": "sheuch",
     "local": "Sheuch",
     "english": "Ditch",
     "say": "SHOOKH"
    },
    {
     "id": "loanen",
     "local": "Loanen",
     "english": "Lane, farm track",
     "say": "LOH-nen"
    },
    {
     "id": "pad",
     "local": "Pad",
     "english": "Path",
     "say": "PAD"
    },
    {
     "id": "stane",
     "local": "Stane",
     "english": "Stone",
     "say": "STAYN"
    },
    {
     "id": "toon",
     "local": "Toon",
     "english": "Town",
     "say": "TOON"
    },
    {
     "id": "kye",
     "local": "Kye",
     "english": "Cattle",
     "say": "KYE",
     "note": "Rhymes with 'sky'."
    },
    {
     "id": "coo",
     "local": "Coo",
     "english": "Cow",
     "say": "COO"
