    "y": 4,
    "name": "Ivan",
    "sprite": "tour_guide"
   },
   "intro": [
    "The giant Finn McCool built this causeway, or so they say. The geologists say lava.",
    "Either way, here's how to say no like a local."
   ],
   "words": [
    {
     "id": "cannae",
     "local": "Cannae",
     "english": "Can't",
     "say": "CAN-ay"
    },
    {
     "id": "winnae",
     "local": "Winnae",
     "english": "Won't",
     "say": "WIN-ay"
    },
    {
     "id": "cudnae",
     "local": "Cudnae",
     "english": "Couldn't",
     "say": "CUD-nay"
    },
    {
     "id": "hinnae",
     "local": "Hinnae",
     "english": "Haven't",
     "say": "HIN-ay"
    },
    {
     "id": "hae",
     "local": "Hae",
     "english": "Have",
     "say": "HAY"
    },
    {
     "id": "gie",
     "local": "Gie",
     "english": "Give",
     "say": "GEE",
     "note": "Hard 'g', as in 'geese'."
    },
    {
     "id": "gan",
     "local": "Gan",
     "english": "Go",
     "say": "GAN"
    },
    {
     "id": "frae",
     "local": "Frae",
     "english": "From",
     "say": "FRAY",
     "note": "Also 'fae'."
    }
