 },
 "lessons": [
  {
   "id": "gv_01",
   "title": "Moghrey mie! Hello",
   "level": 1,
   "teacher": {
    "zone": "douglas_gaiety",
    "x": 10,
    "y": 3,
    "name": "Juan",
    "sprite": "villager_1"
   },
   "intro": [
    "Fastyr mie! That's good afternoon, and good evening too.",
    "Manx was nearly lost. Every new learner is a small win for the island."
   ],
   "words": [
    {
     "id": "moghrey_mie",
     "local": "Moghrey mie",
     "english": "Good morning",
     "say": "MAW-ra my"
    },
    {
     "id": "fastyr_mie",
     "local": "Fastyr mie",
     "english": "Good afternoon, good evening",
     "say": "FASS-ter my"
    },
    {
     "id": "oie_vie",
     "local": "Oie vie",
     "english": "Good night",
     "say": "ee VY"
    },
    {
     "id": "kys_tou",
     "local": "Kys t'ou?",
     "english": "How are you?",
     "say": "kiss TOW",
     "note": "To one person you know well."
    },
    {
     "id": "gura_mie_ayd",
     "local": "Gura mie ayd",
     "english": "Thank you",
     "say": "GOO-ra my ADGE",
     "note": "To one person. To several it's 'Gura mie eu'."
    },
    {
     "id": "slane_lhiat",
     "local": "Slane lhiat",
     "english": "Goodbye",
     "say": "slayn LYAT"
    },
    {
     "id": "slaynt",
     "local": "Slaynt!",
     "english": "Cheers!",
     "say": "SLANCH",
     "note": "Like Irish sláinte: health."
    }
   ],
   "tip": "Manx is spelt more like English than Irish is, because it was first written down by people who knew English spelling."
  },
