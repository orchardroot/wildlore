     "say": "uh HOON"
    },
    {
     "id": "a_dha",
     "local": "a dhà",
     "english": "two",
     "say": "uh GHAH"
    },
    {
     "id": "a_tri",
     "local": "a trì",
     "english": "three",
     "say": "uh TREE"
    },
    {
     "id": "a_ceithir",
     "local": "a ceithir",
     "english": "four",
     "say": "uh KAY-hir"
    },
    {
     "id": "a_coig",
     "local": "a còig",
     "english": "five",
     "say": "uh KAW-ik"
    },
    {
     "id": "a_sia",
     "local": "a sia",
     "english": "six",
     "say": "uh SHEE-uh"
    },
    {
     "id": "a_seachd",
     "local": "a seachd",
     "english": "seven",
     "say": "uh SHACHK"
    },
    {
     "id": "a_h_ochd",
     "local": "a h-ochd",
     "english": "eight",
     "say": "uh HOCHK"
    },
    {
     "id": "a_naoi",
     "local": "a naoi",
     "english": "nine",
     "say": "uh NOO-ee"
    },
    {
     "id": "a_deich",
     "local": "a deich",
     "english": "ten",
     "say": "uh JAYCH"
    }
   ],
   "tip": "Counting out loud, each number takes a little 'a' in front, and the vowel ones gain an h-: a h-aon, a h-ochd."
  },
