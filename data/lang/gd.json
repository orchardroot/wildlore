 "about": [
  "Gàidhlig (GAH-lik) is the Gaelic of Scotland, spoken most in the Western Isles, Skye and the west Highlands.",
  "It grew from the same old Gaelic as Irish, but the two have long gone their own ways: cousins, not twins.",
  "The 2022 census counted about 130,000 people in Scotland with some Gaelic, and it is still a home language in the islands.",
  "The Gaelic Language (Scotland) Act 2005 made it an official language of Scotland. There is Gaelic in Nova Scotia, Canada, too."
 ],
 "lessons": [
  {
   "id": "gd_01",
   "title": "Halò! Hello and thanks",
   "level": 1,
   "teacher": {
    "zone": "stornoway_lanntair",
    "x": 9,
    "y": 6,
    "name": "Ealasaid",
    "sprite": "villager_5"
   },
   "intro": [
    "Halò! You'll hear more Gaelic in the Western Isles than anywhere else in Scotland.",
    "Ten words and you can get through a day here. Well, a morning."
   ],
   "words": [
    {
     "id": "halo",
     "local": "Halò",
     "english": "Hello",
     "say": "HAH-loh"
    },
    {
     "id": "madainn_mhath",
     "local": "Madainn mhath",
     "english": "Good morning",
     "say": "MAT-in VAH"
    },
    {
     "id": "feasgar_math",
     "local": "Feasgar math",
     "english": "Good afternoon, good evening",
     "say": "FESS-kur MAH"
    },
    {
     "id": "oidhche_mhath",
     "local": "Oidhche mhath",
     "english": "Good night",
     "say": "OY-chuh VAH",
     "note": "The ch is the one in 'loch', never the one in 'church'."
    },
    {
     "id": "ciamar_a_tha_thu",
     "local": "Ciamar a tha thu?",
     "english": "How are you?",
     "say": "KIM-er uh HA oo"
    },
    {
     "id": "tha_gu_math",
     "local": "Tha gu math",
     "english": "I'm well",
     "say": "HA goo MAH"
    },
    {
     "id": "tapadh_leat",
     "local": "Tapadh leat",
     "english": "Thank you",
     "say": "TAH-puh let",
     "note": "To a friend. To an elder, a stranger or a crowd: tapadh leibh (TAH-puh layv)."
    },
    {
     "id": "tha",
     "local": "Tha",
     "english": "Yes (it is)",
     "say": "HA",
     "note": "Gaelic has no single word for yes. You answer with the verb: is it? It is."
    },
    {
     "id": "chan_eil",
     "local": "Chan eil",
     "english": "No (it isn't)",
     "say": "chan YELL"
    },
    {
     "id": "slainte_mhath",
     "local": "Slàinte mhath!",
     "english": "Good health! Cheers!",
     "say": "SLAHN-chuh VAH"
    }
   ],
   "tip": "Gaelic has two words for 'you': thu for one friend, sibh for an elder, a stranger or more than one. Leat and leibh follow the same rule."
  },
  {
