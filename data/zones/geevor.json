 "signs": [
  {
   "x": 24,
   "y": 29,
   "text": "GEEVOR. In 1990 the last tin came out of the ground in West Penwith. The tunnels reach out under the Atlantic. The sea is above your head. Please do not worry."
  },
  {
   "x": 25,
   "y": 21,
   "text": "LEVEL ONE. The tin ore was hand-drilled by candlelight before safety lamps came along. The miners wore felt hats hardened with resin. And bravery."
  },
  {
   "x": 20,
   "y": 7,
   "text": "KNOCKERS. Tapping in the rock means the knockers are about. Miners left them a bit of crust. If you don't have crust, a firm 'excuse me' is polite."
  }
 ],
 "spawn": [
