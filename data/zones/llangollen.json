 "signs": [
  {
   "x": 26,
   "y": 11,
   "text": "CHAIN BRIDGE. Wobble gently. It's been doing it since 1814, and the River Dee has tried to remove it more than once."
  },
  {
   "x": 53,
   "y": 17,
   "text": "EISTEDDFOD FIELD. Choirs from fifty countries every July. Do not shush the sopranos."
  },
  {
   "x": 3,
   "y": 17,
   "text": "LLANGOLLEN. Croeso i Langollen. Welcome to the town where everyone sings and nobody admits it."
  },
  {
   "x": 44,
   "y": 23,
   "text": "RAILWAY. Steam trains up the valley. Tickets from the man in the hat."
  },
  {
   "x": 15,
   "y": 33,
   "text": "DINAS BRAN. The castle on the hill. 'Fortress of the crow'. Crows have the lease."
  },
  {
   "x": 61,
   "y": 17,
   "text": "EAST: Dee Valley and the Aqueduct. Bring a head for heights, or a boat."
  }
 ],
