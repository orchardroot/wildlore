 "signs": [
  {
   "x": 50,
   "y": 11,
   "text": "SEA TERMINAL. Ferries to Liverpool. Don't be late: the captain isn't sentimental."
  },
  {
   "x": 46,
   "y": 31,
   "text": "THE TOWER OF REFUGE. Built 1832 so shipwrecked sailors had somewhere to wait. Still the poshest lighthouse ever. Founded by the chap who started the RNLI."
  },
  {
   "x": 45,
   "y": 13,
   "text": "DOUGLAS PROMENADE. Two miles of Victorian hotels. The Manx wind will find every one."
  },
  {
   "x": 44,
   "y": 49,
   "text": "DOUGLAS HEAD, south. Not on this map. Or any map, it's mostly cliff."
  },
  {
   "x": 45,
   "y": 19,
   "text": "HORSE TRAM. Running since 1876. Oldest surviving horse tramway in the world. Powered by one horse, several opinions."
  },
  {
   "x": 5,
   "y": 9,
   "text": "THE LAXEY WHEEL, 'Lady Isabella', 1854. Nearly 22 metres across. The largest working waterwheel on Earth. This is a very approximate model."
  },
  {
   "x": 24,
   "y": 21,
   "text": "GAIETY THEATRE. Victorian, ornate, haunted by exactly the right amount of ghost."
  },
  {
   "x": 14,
   "y": 32,
   "text": "ISLE OF MAN STEAM RAILWAY. Narrow gauge, wide smile, puffs of coal smoke and nostalgia."
  },
  {
   "x": 30,
   "y": 31,
   "text": "MANX KIPPERS. Smoked herring. The smell announces itself three streets away."
  },
  {
   "x": 22,
   "y": 39,
   "text": "LOAGHTAN FIELD. Four horns, one opinion: leave us alone. They are mouse-coloured, and they know it."
  },
  {
   "x": 10,
   "y": 48,
   "text": "DOUGLAS HEAD. Cliffs this way. Seagulls that way. Chips somewhere between."
  }
 ],
