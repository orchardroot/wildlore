 "signs": [
  {
   "x": 23,
   "y": 20,
   "text": "PENSHAW MONUMENT. Built in 1844 for John Lambton, first Earl of Durham, and modelled on a temple in Athens. It has 18 columns, 70 feet high. It was never given a roof, and has been a pleasingly unfinished temple ever since."
  },
  {
   "x": 20,
   "y": 9,
   "text": "WORM HILL. Legend says the Lambton Worm coiled round this hill and ate sheep, milk and the odd cow, until young John Lambton beat it in armour studded with blades. The song is still sung in Sunderland pubs, with feeling."
  }
 ],
