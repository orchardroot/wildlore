 "signs": [
  {
   "x": 5,
   "y": 19,
   "text": "SEVERN BRIDGE. Opened 1966 by the Queen, with a 988 m main span. TOLLS ABOLISHED 17 DEC 2018. This booth now collects dust and dad jokes."
  },
  {
   "x": 56,
   "y": 19,
   "text": "WELCOME TO ENGLAND. Speed limit 50 on the bridge. Wind limit: your hat."
  },
  {
   "x": 38,
   "y": 19,
   "text": "THE SECOND SEVERN CROSSING, 1996, a cable-stayed bridge a little further down the river. The Severn has one of the biggest tides in the world, about 14 m. The mud knows."
  },
  {
   "x": 16,
   "y": 13,
   "text": "SOFT MUD. Estuary tides rise faster than you can run. Please don't feed the waders. They're on a strict diet of worm."
  }
 ],
