  },
  {
   "id": "arena_fan",
   "sprite": "rugby_player",
   "x": 12,
   "y": 11,
   "facing": "up",
   "move": "still",
   "text": "Rhys trains in this every day. Sideways rain, he calls it a light mist. Watch his lineout.",
   "hide_if": "trainer_keeper_rhys"
  },
  {
   "id": "arena_fan_won",
   "sprite": "rugby_player",
   "x": 12,
   "y": 11,
   "facing": "up",
   "move": "still",
   "text": "Never seen Rhys knocked on like that. I'll be telling it in the clubhouse till Easter.",
   "show_if": "trainer_keeper_rhys"
  },
  {
