  {
   "id": "arena_choir_won",
   "sprite": "choir_singer",
   "x": 4,
   "y": 11,
   "facing": "up",
   "move": "still",
   "text": "We sang Rhys on and we'll sing you off. Bread of Heaven, feed me till I want no more. Or a pasty.",
