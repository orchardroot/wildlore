 "signs": [
  {
   "x": 24,
   "y": 19,
   "plaque": "cyprus_pyla",
   "title": "Pyla",
   "text": "Pyla sits inside the UN buffer zone, on the edge of the Dhekelia Sovereign Base Area, and is one of very few places on the island where Greek Cypriots and Turkish Cypriots still live side by side, as many villages did before the 1960s. The UN keeps a post on the hill. The children mostly ignore it."
  },
  {
   "x": 25,
   "y": 23,
   "plaque": "cyprus_pyla_coffee",
   "title": "Two Coffee Houses",
   "text": "On the square, two coffee houses stand a few steps apart, one Greek Cypriot and one Turkish Cypriot. The coffee is the same coffee: finely ground, boiled in a small long-handled pot and served with the grounds settling in the cup. What you call it depends on which door you went in."
  },
  {
   "x": 43,
   "y": 23,
   "plaque": "cyprus_unficyp",
   "title": "Blue Berets",
   "text": "UNFICYP, the United Nations Peacekeeping Force in Cyprus, arrived in 1964 after fighting between the island's two communities, and has stayed ever since: one of the oldest UN missions anywhere. Its soldiers and police come from many countries, Britain among them, and they patrol a buffer zone that runs right across the island."
  },
  {
   "x": 25,
   "y": 10,
   "plaque": "cyprus_mesaoria",
   "title": "The Mesaoria",
   "text": "The road north crosses the Mesaoria, whose name means 'between the mountains': the wide plain between the Troodos range in the south-west and the Kyrenia range in the north. It is Cyprus's breadbasket, wheat and barley gold in May and baked brown by August."
  },
  {
   "x": 29,
   "y": 3,
   "text": "NICOSIA, north. DHEKELIA, south. Mind the tractors."
  }
 ],
