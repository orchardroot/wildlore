  {
   "id": "vt_pa",
   "sprite": "commuter",
   "x": 24,
   "y": 8,
   "facing": "left",
   "move": "still",
   "text": "Lord Vane's diary is full until 2031. I've pencilled you in for a defeat. His, apparently, not yours.",
   "hide_if": "game_complete"
  },
  {
   "id": "vt_pa_won",
   "sprite": "commuter",
   "x": 24,
   "y": 8,
   "facing": "left",
   "move": "still",
   "text": "I've cleared his diary. All of it. I'm updating my CV on the work laptop. It feels wonderful.",
   "show_if": "game_complete"
  },
  {
   "id": "vt_intern",
   "sprite": "student",
   "x": 6,
   "y": 12,
   "facing": "right",
   "move": "still",
   "text": "I'm only an intern. I fetch the coffee and polish the cages. I've started leaving the cages unlocked.",
   "hide_if": "game_complete"
  },
  {
   "id": "vt_intern_won",
   "sprite": "student",
   "x": 6,
   "y": 12,
   "facing": "right",
   "move": "still",
   "text": "I've let them all out. The cages, the creatures, the lot. Nobody's said a word. Is that allowed?",
   "show_if": "game_complete"
  },
  {
   "id": "vt_cleaner",
   "sprite": "villager_2",
   "x": 23,
   "y": 17,
   "facing": "left",
   "move": "still",
   "text": "I've cleaned this floor every night for six years. You can see the whole city through it. I don't look.",
   "hide_if": "game_complete"
  },
  {
   "id": "vt_cleaner_won",
   "sprite": "villager_2",
   "x": 23,
   "y": 17,
   "facing": "left",
   "move": "still",
   "text": "Leaving the windows unpolished tonight. Let London have a look in for once.",
   "show_if": "game_complete"
  }
 ],
