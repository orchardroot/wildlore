  },
  {
   "id": "docks_fisher_won",
   "sprite": "fisher",
   "x": 4,
   "y": 10,
   "facing": "up",
   "move": "still",
   "text": "First time I've seen her lose her footing on that quay. Mind, it's been a slippy year.",
   "show_if": "trainer_keeper_nuala"
  },
  {
   "id": "docks_singer",
   "sprite": "sean_nos_singer",
   "x": 14,
   "y": 10,
   "facing": "up",
   "move": "still",
   "text": "The tide's on her side, she says. The tide's on nobody's side. It just turns up.",
   "hide_if": "trainer_keeper_nuala"
  },
  {
   "id": "docks_singer_won",
   "sprite": "sean_nos_singer",
   "x": 14,
   "y": 10,
   "facing": "up",
   "move": "still",
   "text": "Grand job. I'll sing about it at the Crane Bar later. You'll hardly recognise yourself.",
   "show_if": "trainer_keeper_nuala"
  },
  {
   "id": "docks_gannets",
   "sprite": "birdwatcher",
   "x": 17,
   "y": 10,
   "facing": "left",
   "move": "still",
   "text": "If you hear a splash, it's a gannet. If you hear a bigger splash, it's one of Nuala's.",
   "hide_if": "trainer_keeper_nuala"
  },
  {
   "id": "docks_gannets_won",
