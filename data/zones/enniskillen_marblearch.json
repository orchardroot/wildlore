 "signs": [
  {
   "x": 14,
   "y": 19,
   "text": "MARBLE ARCH CAVES. Keep to the path, mind your head, and please don't touch the formations: the grease from one finger can stop a stalactite growing."
  },
  {
   "x": 16,
   "y": 14,
   "plaque": "en_cave_river",
   "title": "The Underground River",
   "text": "Three streams run off Cuilcagh mountain and vanish into the limestone, carving these caves as they go. Here they meet as an underground river, and tours glide along it by boat before anyone sets foot in the deeper chambers."
  },
  {
   "x": 5,
   "y": 5,
   "plaque": "en_grand_gallery",
   "title": "The Grand Gallery",
   "text": "Stalactites hang from the roof and stalagmites rise from the floor, each grown drop by drop as water leaves a little calcite behind. They grow so slowly that the ones you see took thousands of years. Look, but please don't touch."
  },
  {
   "x": 9,
   "y": 2,
   "text": "A steep stair of cut limestone leads down by the Grand Gallery wall. A sign says 'SURVEY ROUTE: HELMET, LAMP, AND GOOD SENSE ONLY'."
  }
 ],
