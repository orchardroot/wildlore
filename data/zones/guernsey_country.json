 "signs": [
  {
   "x": 32,
   "y": 13,
   "plaque": "channel_islands_chapel",
   "title": "The Little Chapel",
   "text": "One of the smallest consecrated churches in the world, in the grounds of a Christian Brothers' school at Les Vauxbelets. Brother D\u00e9odat began it in 1914 as a model of the grotto at Lourdes, and decorated every surface with pebbles, seashells and bits of broken china that islanders brought him. Visitors still add to it."
  },
  {
   "x": 21,
   "y": 18,
   "plaque": "channel_islands_gue_occupation_museum",
   "title": "The Occupation Museum",
   "text": "A private museum at Forest, founded from one man's collection of wartime objects: ration books, forged papers, a hidden radio, a reconstructed kitchen from 1944. Everything on show was used by islanders, or left by the soldiers who occupied the island between 1940 and 1945."
  },
  {
   "x": 14,
   "y": 38,
   "plaque": "channel_islands_fortgrey",
   "title": "Fort Grey",
   "text": "A round tower at Rocquaine Bay, built in 1804 against the threat of a French invasion, on a rock off the shore. It was called the Cup and Saucer for its shape. Today it is a museum of shipwrecks, and these shores have seen a great many, among the rockiest in the Channel."
  },
  {
   "x": 38,
   "y": 33,
   "plaque": "channel_islands_glasshouses",
   "title": "The Glasshouses",
   "text": "In the twentieth century Guernsey was covered in glasshouses, long low barns of glass called vineries, growing tomatoes and grapes and flowers for the mainland. The island's tomatoes were shipped out by the shipload. Many have gone, but their ghosts still sparkle in the sun."
  },
  {
   "x": 22,
   "y": 30,
   "plaque": "channel_islands_trepied",
   "title": "Le Tr\u00e9pied",
   "text": "A Neolithic passage tomb on the west coast, about 5,000 years old, called Le Tr\u00e9pied after its three-footed shape. Island folklore says witches met here for their sabbath on Friday nights, and in the sixteenth and seventeenth centuries some Guernsey women paid dearly for stories like that."
  },
  {
   "x": 8,
   "y": 20,
   "plaque": "channel_islands_cobo",
   "title": "Cobo Bay",
   "text": "A broad sandy bay on the west coast, famous for its sunsets. At low tide the sand runs out for hundreds of yards among rock pools. Islanders gather ormers here in the right season, at the lowest tides, and keep the rules to the letter."
  },
  {
   "x": 44,
   "y": 26,
   "plaque": "channel_islands_guernsey_lanes",
   "title": "The Guernsey Lanes",
   "text": "Guernsey's lanes are narrow and winding, and the cars crawl behind tractors. Some lanes are marked as Ruettes Tranquilles, quiet lanes where walkers, cyclists and riders have priority over drivers, with a speed limit of 15 miles an hour."
  },
  {
   "x": 44,
   "y": 20,
   "plaque": "channel_islands_sausmarez",
   "title": "Sausmarez Manor",
   "text": "A house in the south of the island, where the Sausmarez family have lived for centuries. The Queen Anne part dates from 1714. Its garden has subtropical plants, and a sculpture park, because Guernsey's mild climate lets palms and ferns thrive where you might expect only cabbages."
  },
  {
   "x": 36,
   "y": 12,
   "plaque": "channel_islands_sark",
   "title": "A Nod to Sark",
   "text": "Sark lies a few miles east of Guernsey, a rock island with no cars. In 2011 it was named the world's first Dark Sky Island, with no street lights and a sky full of stars. The boat from St Peter Port takes about an hour."
  },
  {
   "x": 55,
   "y": 23,
   "text": "EAST: St Peter Port. NORTH from the crossroads: the Little Chapel. SOUTH: the glasshouses and the south coast. WEST: the bays and Fort Grey."
  }
 ],
