 "signs": [
  {
   "x": 23,
   "y": 19,
   "text": "LLANBERIS. Croeso i Lanberis. Welcome! Population: some people and a great many sheep."
  },
  {
   "x": 60,
   "y": 17,
   "text": "EAST: Nant Ffrancon, Llyn Ogwen, Tryfan. Dwyrain. Bring chocolate."
  },
  {
   "x": 57,
   "y": 4,
   "text": "YR WYDDFA (SNOWDON). 1,085 m. Walk, or ride the little train. The mountain does not mind. It has seen it all."
  },
  {
   "x": 25,
   "y": 38,
   "text": "SOUTH: Cambrian Coast. Y De. Please do not feed the seagulls. They have a union too."
  },
  {
   "x": 16,
   "y": 17,
   "text": "DINORWIC QUARRY. 1787 to 1969. Hard hats provided. Hard heads optional."
  },
  {
   "x": 43,
   "y": 22,
   "text": "ELECTRIC MOUNTAIN. A power station inside a mountain. Wales: 'we put the lights on, under a hill'."
  },
  {
   "x": 9,
   "y": 25,
   "text": "DOLBADARN CASTLE. 13th century. One round tower, a lot of Welsh princes, no roof. Still standing."
  }
 ],
