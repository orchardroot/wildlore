{
 "nurse": [
  {
   "do": "say",
   "who": "Nurse",
   "text": "Hey there, welcome to the Sanctuary. Which side of the state line are you on? Doesn't matter, we heal both."
  },
  {
   "do": "choice",
   "text": "What can we do for you?",
   "options": [
    "Heal my team",
    "Open the Ark",
    "Just looking"
   ],
   "set": "_nurse_choice"
  },
  {
   "do": "if",
   "flag": "_nurse_choice",
   "eq": 0,
   "then": [
    {
     "do": "say",
     "who": "Nurse",
     "text": "Set 'em down there, sugar."
    },
    {
     "do": "heal"
    },
    {
     "do": "say",
     "who": "Nurse",
     "text": "All better. Fit as a fiddle, as we say."
    }
   ],
   "else": [
    {
     "do": "if",
     "flag": "_nurse_choice",
     "eq": 1,
     "then": [
      {
       "do": "say",
       "who": "Nurse",
       "text": "The Ark's round back."
      },
      {
       "do": "ark"
      }
     ],
     "else": [
      {
       "do": "say",
       "who": "Nurse",
       "text": "Y'all come back now."
      }
     ]
    }
   ]
  }
 ]
}