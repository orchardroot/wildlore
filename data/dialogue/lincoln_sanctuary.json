{
 "nurse": [
  {
   "do": "say",
   "who": "Nurse",
   "text": "Ey up, me duck! Welcome to Lincoln Sanctuary. Up or down the hill today?"
  },
  {
   "do": "choice",
   "text": "What can we do for you?",
   "options": [
    "Heal my team",
    "Open the Ark",
    "Just looking"
   ],
   "set": "_nurse_choice"
  },
  {
   "do": "if",
   "flag": "_nurse_choice",
   "eq": 0,
   "then": [
    {
     "do": "say",
     "who": "Nurse",
     "text": "Sit yourself down. There's plum bread and a bit of Poacher on the side."
    },
    {
     "do": "heal"
    },
    {
     "do": "say",
     "who": "Nurse",
     "text": "All better. Mind Steep Hill on the way back up, it's a killer."
    }
   ],
   "else": [
    {
     "do": "if",
     "flag": "_nurse_choice",
     "eq": 1,
     "then": [
      {
       "do": "say",
       "who": "Nurse",
       "text": "The Ark's in the corner, me duck. Click away."
      },
      {
       "do": "ark"
      }
     ],
     "else": [
      {
       "do": "say",
       "who": "Nurse",
       "text": "Ta-ra, me duck."
      }
     ]
    }
   ]
  }
 ]
}