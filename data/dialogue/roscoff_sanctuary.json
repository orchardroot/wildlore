{
 "nurse": [
  {
   "do": "say",
   "who": "Nurse",
   "text": "Demat! Bonjour! Welcome to the Sanctuary. We speak French, Breton and fluent seagull."
  },
  {
   "do": "choice",
   "text": "What can we do for you?",
   "options": [
    "Heal my team",
    "Open the Ark",
    "Just looking"
   ],
   "set": "_nurse_choice"
  },
  {
   "do": "if",
   "flag": "_nurse_choice",
   "eq": 0,
   "then": [
    {
     "do": "say",
     "who": "Nurse",
     "text": "Lay them down. Un petit moment."
    },
    {
     "do": "heal"
    },
    {
     "do": "say",
     "who": "Nurse",
     "text": "Voil\u00e0. Good as new."
    }
   ],
   "else": [
    {
     "do": "if",
     "flag": "_nurse_choice",
     "eq": 1,
     "then": [
      {
       "do": "say",
       "who": "Nurse",
       "text": "The Ark is by the window, with a view of the \u00cele de Batz."
      },
      {
       "do": "ark"
      }
     ],
     "else": [
      {
       "do": "say",
       "who": "Nurse",
       "text": "Kenavo! Goodbye!"
      }
     ]
    }
   ]
  }
 ]
}