       ],
       "eq": "spikkin"
      },
      {
       "do": "if",
       "flag": "starter",
       "then": [
        {
         "do": "battle",
         "trainer": "kit_1_vs_holtling"
        }
       ],
       "eq": "holtling"
      },
      {
       "do": "if",
       "flag": "starter",
       "then": [
        {
         "do": "battle",
         "trainer": "kit_1_vs_kindlet"
