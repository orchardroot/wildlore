{
 "nurse": [
  {
   "do": "say",
   "who": "Nurse",
   "text": "Hi, welcome to the Sanctuary. We take insurance, cash and wild creatures, no questions."
  },
  {
   "do": "choice",
   "text": "What can we do for you?",
   "options": [
    "Heal my team",
    "Open the Ark",
    "Just looking"
   ],
   "set": "_nurse_choice"
  },
  {
   "do": "if",
   "flag": "_nurse_choice",
   "eq": 0,
   "then": [
    {
     "do": "say",
     "who": "Nurse",
     "text": "Put them down there. I'll be quick, this is Boston."
    },
    {
     "do": "heal"
    },
    {
     "do": "say",
     "who": "Nurse",
     "text": "All set. Good as new, maybe better."
    }
   ],
   "else": [
    {
     "do": "if",
     "flag": "_nurse_choice",
     "eq": 1,
     "then": [
      {
       "do": "say",
       "who": "Nurse",
       "text": "The Ark's down the hall, past the vending machine."
      },
      {
       "do": "ark"
      }
     ],
     "else": [
      {
       "do": "say",
       "who": "Nurse",
       "text": "Take care now."
      }
     ]
    }
   ]
  }
 ]
}